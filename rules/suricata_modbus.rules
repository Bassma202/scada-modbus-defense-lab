# ==============================================================================
# Suricata OT / ICS Detection Rules for Modbus TCP Industrial Network
# Author: Bassma Alaoui Sossey | Specialization: OT & Critical Infrastructure Security
# Target Protocol: Modbus TCP (Port 502 / 5020 / 5021)
# ==============================================================================

# 1. Alert on Modbus Device Enumeration & Identification (Reconnaissance)
alert modbus any any -> $HOME_NET [502,5020,5021] (msg:"ICS ALERT: Modbus Read Device Identification Probe (MEI Type 14)"; \
    flow:established,to_server; \
    modbus.function:43; \
    classtype:attempted-recon; \
    sid:1000001; rev:1; \
    reference:url,attack.mitre.org/techniques/T0888/;)

# 2. Alert on Diagnostic Function Code Execution
alert modbus any any -> $HOME_NET [502,5020,5021] (msg:"ICS ALERT: Modbus Diagnostics Function (FC 08) Query"; \
    flow:established,to_server; \
    modbus.function:8; \
    classtype:attempted-recon; \
    sid:1000002; rev:1; \
    reference:url,attack.mitre.org/techniques/T0888/;)

# 3. Alert on Unauthorized Coil Write (Forced Stop / Trip)
alert modbus any any -> $HOME_NET [502,5020,5021] (msg:"ICS SUSPICIOUS: Modbus Force Single Coil Write (FC 05) - Potential Tripping Attack"; \
    flow:established,to_server; \
    modbus.function:5; \
    classtype:bad-unknown; \
    sid:1000003; rev:1; \
    reference:url,attack.mitre.org/techniques/T0855/;)

# 4. Critical Alert: Modbus Holding Register Write (Pump Speed Override)
alert modbus any any -> $HOME_NET [502,5020,5021] (msg:"ICS CRITICAL: Modbus Write Single Register (FC 06) to Holding Register 0x0000 (Pump RPM)"; \
    flow:established,to_server; \
    modbus.function:6; \
    modbus.address:0; \
    classtype:policy-violation; \
    sid:1000004; rev:1; \
    reference:url,attack.mitre.org/techniques/T0831/;)

# 5. Alert on Gateway Exception Response (DPI Dropped Malicious Packet)
alert modbus $HOME_NET [502,5020,5021] -> any any (msg:"ICS DEFENSE: Modbus Gateway Exception Response (Code 0x04 - Policy Blocked)"; \
    flow:established,to_client; \
    content:"|86 04|"; \
    classtype:successful-recon-limited; \
    sid:1000005; rev:1;)
