# AETHER — Suricata 7 OT/ICS Modbus TCP Detection Rules (Validated via suricata -T & live PCAP)
# MITRE ATT&CK for ICS mappings: T0888 (Remote System Info Discovery), T0855 (Unauthorized Command Message)

alert modbus any any -> any [502,5020,5021] (msg:"AETHER ICS: Modbus Read Device Identification Probe (FC 43)"; flow:to_server; modbus:function 43; classtype:attempted-recon; sid:2000001; rev:2; reference:url,attack.mitre.org/techniques/T0888/;)

alert modbus any any -> any [502,5020,5021] (msg:"AETHER ICS: Modbus Diagnostics Function Query (FC 08)"; flow:to_server; modbus:function 8; classtype:attempted-recon; sid:2000002; rev:2; reference:url,attack.mitre.org/techniques/T0888/;)

alert modbus any any -> any [502,5020,5021] (msg:"AETHER ICS: Modbus Write Single Coil Command (FC 05 - Pump Trip Risk)"; flow:to_server; modbus:function 5; classtype:attempted-admin; sid:2000003; rev:2; reference:url,attack.mitre.org/techniques/T0855/;)

alert modbus any any -> any [502,5020,5021] (msg:"AETHER ICS: Modbus Write Single Register to Pump Setpoint (FC 06)"; flow:to_server; modbus:function 6; classtype:attempted-admin; sid:2000004; rev:2; reference:url,attack.mitre.org/techniques/T0855/;)

alert modbus any any -> any [502,5020,5021] (msg:"AETHER ICS: Modbus Write Multiple Registers (FC 16)"; flow:to_server; modbus:function 16; classtype:attempted-admin; sid:2000005; rev:2; reference:url,attack.mitre.org/techniques/T0855/;)
